# Lenora local configuration. bootstrap copies this to .env; never commit .env.

# Shared secret between the editor and lenora-backend. bootstrap generates it.
LENORA_TOKEN=

# development reads this file; production reads only the platform environment.
LENORA_ENV=development

# Cloudinary — Console → Settings → API Keys (https://console.cloudinary.com/settings/api-keys).
# Leave empty to keep Cloudinary features off.
LENORA_CLOUDINARY_CLOUD_NAME=
LENORA_CLOUDINARY_API_KEY=
LENORA_CLOUDINARY_API_SECRET=
# Free plan caps on-the-fly video at 40 MB; paid plans at 300 MB (314572800). Used from spec 2.
LENORA_CLOUDINARY_ON_THE_FLY_VIDEO_MAX_BYTES=41943040
# auto | on | off — add-ons that need a paid Cloudinary plan. Used from spec 2.
LENORA_CLOUDINARY_IMAGE_GENERATION=auto
LENORA_CLOUDINARY_IMAGE_TO_VIDEO=auto
