# Lenora local configuration. bootstrap copies this to .env; never commit .env.

# Shared secret between the editor and lenora-backend. bootstrap generates it.
LENORA_TOKEN=

# development reads this file; production reads only the platform environment.
LENORA_ENV=development

# Cloudinary — Console → Settings → API Keys (https://console.cloudinary.com/settings/api-keys).
# Leave empty to keep Cloudinary features off.
LENORA_CLOUDINARY_CLOUD_NAME=
LENORA_CLOUDINARY_API_KEY=
LENORA_CLOUDINARY_API_SECRET=
# Free plan caps on-the-fly video at 40 MB; paid plans at 300 MB (314572800).
LENORA_CLOUDINARY_ON_THE_FLY_VIDEO_MAX_BYTES=41943040
# auto (default): try the add-on; a refusal hides it until Settings → Backend → Test Connection.
# on: always offer it. off: never offer it.
LENORA_CLOUDINARY_IMAGE_GENERATION=auto
LENORA_CLOUDINARY_IMAGE_TO_VIDEO=auto
# Where the backend keeps chain jobs and learned add-on state. Default: .data in the working directory.
# LENORA_DATA_DIR=.data
# Optional daily spend cap in Cloudinary credits (UTC day, per process). Empty means unlimited.
LENORA_CLOUDINARY_DAILY_CREDIT_BUDGET=
# Credits per generated image and per second of image-to-video. Cloudinary publishes no add-on prices; these are cautious guesses.
# LENORA_CLOUDINARY_COST_IMAGE_GENERATION=1.0
# LENORA_CLOUDINARY_COST_IMAGE_TO_VIDEO_PER_SECOND=1.0

# OpenAI — https://platform.openai.com/api-keys. Voiceover and Improve Prompt.
# Leave empty to fall back to OPENAI_API_KEY; with neither, OpenAI features stay off.
LENORA_OPENAI_API_KEY=
# Daily spend cap in USD (UTC day, per process), counted from estimates. 0 means no cap.
# LENORA_OPENAI_DAILY_BUDGET_USD=5.0
# LENORA_OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
# LENORA_OPENAI_REWRITE_MODEL=gpt-5.4-mini
# Behind a TLS-terminating proxy: the proxy's address, so result URLs use https.
# LENORA_FORWARDED_ALLOW_IPS=
