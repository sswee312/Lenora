{
  "manifest_version": "0.4",
  "name": "lenora",
  "display_name": "Lenora",
  "version": "0.1.0",
  "description": "Edit your videos with Lenora from Claude Desktop.",
  "long_description": "Connects Claude Desktop to the local MCP server inside Lenora — an AI-native Mac video editor. Once installed, Claude can read your timeline, edit clips, generate media, and manage tracks.",
  "icon": "icon.png",
  "author": {
    "name": "Tushar Verma",
    "url": "https://agentage.xyz"
  },
  "homepage": "https://github.com/vermatushar/lenora",
  "keywords": ["video", "editor", "timeline", "creative", "media"],
  "compatibility": {
    "platforms": ["darwin"],
    "runtimes": {
      "node": ">=18.0.0"
    }
  },
  "user_config": {
    "token": {
      "type": "string",
      "title": "Lenora MCP token",
      "description": "Settings → Agent → Connect an agent → Copy token",
      "sensitive": true,
      "required": true
    },
    "port": {
      "type": "number",
      "title": "Port",
      "default": 19789,
      "required": false
    }
  },
  "server": {
    "type": "node",
    "entry_point": "server/index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/server/index.js"],
      "env": {
        "LENORA_MCP_TOKEN": "${user_config.token}",
        "LENORA_MCP_PORT": "${user_config.port}"
      }
    }
  }
}
