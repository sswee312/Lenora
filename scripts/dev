#!/usr/bin/env bash
# Run lenora-backend and the editor together. Ctrl-C stops both.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
[[ -f "$ROOT/.env" ]] || { echo "No .env — run ./scripts/bootstrap first." >&2; exit 1; }
# Plain shell variables, not exported: the backend reads .env itself, and the editor
# must never inherit provider secrets.
source "$ROOT/.env"
BACKEND_URL="http://127.0.0.1:${LENORA_PORT:-8787}"

pids=()
cleanup() {
  trap - EXIT INT TERM
  for pid in ${pids[@]+"${pids[@]}"}; do kill "$pid" 2>/dev/null || true; done
  wait 2>/dev/null || true
}
trap cleanup EXIT INT TERM

# Process substitution keeps $! on the real process, so cleanup stops it directly.
(cd "$ROOT/backend" && exec uv run lenora-backend) > >(sed -u 's/^/[backend] /') 2>&1 &
pids+=($!)

for _ in $(seq 1 50); do
  curl -fsS "$BACKEND_URL/v1/health" >/dev/null 2>&1 && break
  sleep 0.2
done
curl -fsS "$BACKEND_URL/v1/health" >/dev/null || { echo "Backend did not start; see [backend] logs above." >&2; exit 1; }

"$ROOT/scripts/bundle.sh" debug --fast
APP_BIN="$ROOT/app/.build/Lenora.app/Contents/MacOS/Lenora"
app_env=(LENORA_BACKEND_URL="$BACKEND_URL" LENORA_TOKEN="$LENORA_TOKEN")
# Debug builds read the agent's BYOK keys from the environment.
[[ -n "${ANTHROPIC_API_KEY:-}" ]] && app_env+=(ANTHROPIC_API_KEY="$ANTHROPIC_API_KEY")
[[ -n "${OPENAI_API_KEY:-}" ]] && app_env+=(OPENAI_API_KEY="$OPENAI_API_KEY")
(exec env "${app_env[@]}" "$APP_BIN") > >(sed -u 's/^/[app] /') 2>&1 &
pids+=($!)

# Stock macOS bash 3.2 has no `wait -n`; exit when either process ends.
while kill -0 "${pids[0]}" 2>/dev/null && kill -0 "${pids[1]}" 2>/dev/null; do sleep 1; done
